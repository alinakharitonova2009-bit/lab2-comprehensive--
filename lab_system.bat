@echo off
chcp 65001 >nul
title Система моделирования процессов разработки ПО

:menu
cls
echo ====================================================
echo СИСТЕМА МОДЕЛИРОВАНИЯ ПРОЦЕССОВ РАЗРАБОТКИ ПО
echo ====================================================
echo.
echo 1. Модуль выбора технологий (chapter1.bat)
echo 2. Модуль инспекции кода (chapter2.bat)
echo 3. Модуль сравнительного анализа (chapter3.bat)
echo 4. Запустить все модули последовательно
echo 5. Выход
echo.
set /p choice="Ваш выбор: "

if "%choice%"=="1" call chapter1.bat
if "%choice%"=="2" call chapter2.bat
if "%choice%"=="3" call chapter3.bat

if "%choice%"=="4" (
    call chapter1.bat
    call chapter2.bat
    call chapter3.bat
    
    cls
    echo ====================================================
    echo === ИТОГОВЫЙ ОТЧЕТ СИСТЕМЫ ===
    echo ====================================================
    echo Модуль 1: Рекомендация по выбору редактора сформирована.
    echo Модуль 2: Уровень ревьюера определен.
    echo Модуль 3: Победитель сравнительного анализа выявлен.
    echo.
    
    echo СИСТЕМА МОДЕЛИРОВАНИЯ ПРОЦЕССОВ РАЗРАБОТКИ ПО > report.txt
    echo ======================================= >> report.txt
    echo Отчет сгенерирован: %date% %time% >> report.txt
    echo Все три модуля успешно пройдены пользователем. >> report.txt
    
    echo [УСПЕХ] Итоговый отчет сохранен в файл report.txt!
    echo.
    echo Нажмите любую клавишу для возврата в меню...
    pause
)

if "%choice%"=="5" exit

goto menu